<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="546.0" prefWidth="753.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.treshgame.avgfileenjoyer.controller.MainWindowController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="33.0" prefWidth="339.0">
      <children>
         <HBox prefHeight="30.0" prefWidth="207.0">
            <children>
               <Button fx:id="goBackButton" mnemonicParsing="false" prefHeight="33.0" prefWidth="59.0" text="Back" />
            </children>
         </HBox>
         <Label fx:id="currentDirLabel" alignment="CENTER" text="/">
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </Label>
      </children>
   </HBox>
   <ListView fx:id="filesListView" editable="true" prefHeight="421.0" prefWidth="713.0" />
</VBox>
